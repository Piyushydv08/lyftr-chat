# Copy to .env and fill in real values. Never commit .env.

# ---------------- Backend ----------------
# Key pool: comma-separated, at least 2. Ids are key_1, key_2, ... in this order.
# Tip: create the keys in two different Google Cloud projects; Gemini quotas are per project.
LLM_API_KEYS=replace-with-key-1,replace-with-key-2
# LiteLLM model name served by every key.
LLM_MODEL=gemini/gemini-2.5-flash-lite
# Optional per-key models, aligned with LLM_API_KEYS (blank entry = LLM_MODEL),
# e.g. gemini/gemini-2.5-flash-lite,groq/llama-3.1-8b-instant
LLM_MODELS=
# Optional base URL for OpenAI-compatible providers (applies to every key).
LLM_API_BASE=
LLM_TIMEOUT_SECONDS=30
LLM_MAX_OUTPUT_TOKENS=1024

# SQLite file. In Docker this is on the named volume mounted at /data.
DATABASE_URL=sqlite:////data/app.db

# CORS: comma-separated frontend origins (add your deployed frontend URL).
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Optional regex, e.g. ^https://lyftr-chat.*\.vercel\.app$ for preview deployments.
ALLOWED_ORIGIN_REGEX=

# Enables the X-Simulate-Failure header (must be true on the deployed backend).
ENABLE_FAILURE_SIMULATION=true

DEFAULT_SYSTEM_PROMPT=You are a helpful, concise assistant. Answer clearly and accurately.

# LiteLLM response cache: local (in-memory) or disk (SQLite-backed, survives restarts).
CACHE_TYPE=disk
CACHE_DIR=/data/llm_cache
CACHE_TTL_SECONDS=86400

# How many stored messages are sent back to the model as context (0 = all).
HISTORY_MAX_MESSAGES=50
LOG_LEVEL=INFO
# Swagger UI at /docs
ENABLE_DOCS=true

# ---------------- Frontend ----------------
# Docker: backend URL as seen from the browser (written to config.js at container start).
PUBLIC_API_BASE_URL=http://localhost:8000
# Static hosting (Vercel/Netlify/Render static): same value, baked in at build time.
VITE_API_BASE_URL=http://localhost:8000
